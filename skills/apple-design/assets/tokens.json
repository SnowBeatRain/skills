{
  "name": "liquid-glass",
  "version": "2.0.0",
  "optics": { "maxDpr": 1.5, "maxVisibleLenses": 3, "edgeDisplacement": 15, "regularBlur": 1.2, "regularTint": 0.045, "radius": 30 },
  "intensity": {
    "subtle": { "blur": "12px", "saturate": "140%", "backgroundAlpha": 0.08, "borderAlpha": 0.20, "usage": "大面积容器、侧栏" },
    "medium": { "blur": "24px", "saturate": "180%", "backgroundAlpha": 0.14, "borderAlpha": 0.35, "usage": "默认：卡片、导航栏、弹窗" },
    "strong": { "blur": "36px", "saturate": "220%", "backgroundAlpha": 0.22, "borderAlpha": 0.50, "usage": "按钮、TabBar、小面积控件" }
  },
  "radius": { "sm": "16px", "md": "24px", "lg": "32px", "xl": "44px", "pill": "999px" },
  "shadow": { "sm": "0 8px 24px rgba(0,0,0,0.16)", "md": "0 20px 50px rgba(0,0,0,0.22)", "lg": "0 32px 80px rgba(0,0,0,0.30)" },
  "inset": {
    "top": "inset 0 1px 0 rgba(255,255,255,0.75)",
    "bottom": "inset 0 -1px 0 rgba(255,255,255,0.12)",
    "side": "inset 1px 0 0 rgba(255,255,255,0.18), inset -1px 0 0 rgba(255,255,255,0.18)"
  },
  "highlight": { "radialColor": "rgba(255,255,255,0.38)", "radialRadius": "320px", "sweepColor": "rgba(255,255,255,0.28)", "sweepAngle": "115deg" },
  "motion": { "sweep": "900ms cubic-bezier(0.2,0.8,0.2,1)", "hover": "200ms cubic-bezier(0.2,0.8,0.2,1)", "press": "120ms cubic-bezier(0.2,0.8,0.2,1)", "touchMs": 600 },
  "darkMode": { "backgroundAlpha": 0.06, "borderAlpha": 0.18, "shadow": "0 20px 50px rgba(0,0,0,0.50)", "insetTop": "inset 0 1px 0 rgba(255,255,255,0.28)", "radialColor": "rgba(255,255,255,0.20)", "sweepColor": "rgba(255,255,255,0.14)" },
  "limits": { "maxLayersPerScreen": 3, "maxSurfacesPerScreen": 5, "maxNestingDepth": 3, "maxBlurRadius": "40px", "minRadius": "16px" },
  "cssVariables": {
    "white-rgb": "255,255,255",
    "text-light": "#1d1d1f",
    "text-dark": "#f5f5f7",
    "readable-light": "rgba(255,255,255,0.56)",
    "readable-dark": "rgba(18,18,18,0.80)",
    "solid-light": "#f5f5f7",
    "solid-dark": "#1c1c1e",
    "fallback-light": "rgba(255,255,255,0.96)",
    "fallback-dark": "rgba(28,28,30,0.97)",
    "fallback-border": "rgba(128,128,128,0.60)",
    "gloss-start": "rgba(255,255,255,0.22)",
    "gloss-end": "rgba(255,255,255,0.02)",
    "overlay": "rgba(18,18,18,0.45)",
    "focus-light": "#1d1d1f",
    "focus-dark": "#ffffff",
    "focus-halo": "rgba(128,128,128,0.65)",
    "page-base-light": "#ededed",
    "page-highlight-light": "#fafafa",
    "page-shade-light": "#d4d4d4",
    "page-soft-light": "#e5e5e5",
    "page-base-dark": "#181818",
    "page-highlight-dark": "#363636",
    "page-shade-dark": "#111111",
    "page-soft-dark": "#242424",
    "optics-scene": "#e7e7e7",
    "optics-paper": "#f5f5f5",
    "optics-grid": "#b5b5b5",
    "optics-contour": "#7d7d7d",
    "optics-ink": "#292929",
    "space-1": "4px",
    "space-2": "8px",
    "space-3": "12px",
    "space-4": "16px",
    "space-5": "20px",
    "space-6": "24px",
    "space-8": "32px",
    "space-12": "48px",
    "font": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'PingFang SC', system-ui, sans-serif",
    "body-size": "1rem",
    "title-size": "1.5rem",
    "line-height": "1.6",
    "target-size": "44px",
    "card-width": "420px",
    "content-width": "720px",
    "highlight-opacity": "0.6",
    "press-scale": "0.97",
    "border-width": "1px"
  }
}
